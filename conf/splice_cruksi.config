/*
 * conf/splice_cruksi.config
 *
 * CRUKSI HPC execution profile plus SPLICE job JSON defaults.
 * Keep pipeline logic in the pipeline, and only prepopulate parameters here.
 */

// -------------------------
// CRUKSI executor and resources
// -------------------------
process {
  executor = 'slurm'
  
  clusterOptions = {
    def opts = []

    // Prefer short, stable job names
    def jobName = params.short_job_id ? "${params.short_job_id}_${task.process}" : "${task.process}"
    opts << "--job-name=${jobName}"

    // Partition is cluster-specific, so parameterise it
    if (params.slurm_partition) {
      opts << "--partition=${params.slurm_partition}"
    } else {
      opts << "--partition=compute"
    }

    opts.join(' ')
  }
}

//executor {
//  queueSize = 20
//}

// Avoid publishDir copy hangs on ceph
report.overwrite   = true
timeline.overwrite = true
trace.overwrite    = true

// Provide CRUKSI defaults without forcing them into the pipeline base config
params {
  publish_dir_mode = 'link'

  // Optional, used only for Slurm submission defaults above
  slurm_partition = params.slurm_partition ?: null

  // SPLICE job identifiers if your platform provides them
  job_id       = params.job_id       ?: null
  short_job_id = params.short_job_id ?: null

  // Make outdir deterministic for platform runs, but do not override if user sets it
  outdir = params.outdir ?: "./${params.job_id ?: 'unknown_job'}_output"

  // SPLICE job JSON inputs
  // Only used if you run in platform mode or demo mode, and can be overridden on CLI
  job_json  = params.job_json  ?: "${launchDir}/../input_data/data/job_file.json"
  input_dir = params.input_dir ?: "${launchDir}/../input_data/data"
}