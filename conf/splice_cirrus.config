/*
 * conf/splice_epcc.config
 *
 * EPCC (Cirrus / ARCHER2) execution profile plus SPLICE job JSON defaults.
 * Keep pipeline logic in the pipeline, and only prepopulate parameters here.
 */

// -------------------------
// EPCC executor and resources
// -------------------------
process {
  executor = 'slurm'
  queue    = { params.slurm_partition ?: 'standard' }

  // cirrus defines memory based on no of cpus
  // increase no of cpus to keep mem values approximate to base.config - doubled
  // EPCC memory policy: prefer mem-per-core behaviour rather than explicit --mem
  withName: '.*' {
    memory = null
  }

  withLabel: process_single {
    cpus = { 2 * task.attempt }
  }
  withLabel: process_low {
    cpus = { 4 * task.attempt }
  }
  withLabel: process_medium {
      cpus = { 12 * task.attempt }
  }
  withLabel: process_high {
      cpus = { 24 * task.attempt }
  }
  withLabel: process_high_memory {
    cpus  = { 39 * task.attempt }
    queue = 'highmem'
  }

  // some modules have specific needs, also edit these to set cpus
  withName: ALIGN_BWAMEM2 {
    // modules.config wants 72-90 GB → 90000/2586 ≈ 35 cores
    cpus   = { 
      def size = meta.single_end ? reads.size() : reads[0].size()
      // Files bigger than 700.MB require more memory
      size > 700000000 ? (36* task.attempt) : (28 * task.attempt) }
    memory = null
  }
  withName: POSTPROC_FUNCTIONSPRED {
      // modules.config wants 24 GB → 24000/2586 ≈ 10 cores
      cpus   = { 10 * task.attempt }
      memory = null
  }
  withName: DRAM_DISTILL {
      // modules.config wants 24 GB → 10 cores
      cpus   = { 10 * task.attempt }
      memory = null
  }

  clusterOptions = {
    def opts = []

    // Prefer short, stable job names
    def jobName = params.short_job_id ? "${params.short_job_id}_${task.process}" : "${task.process}"
    opts << "--job-name=${jobName}"
    opts << "--qos=${params.qos ?: 'standard'}"

    // Optional Slurm extras
    if (params.budget) opts << "--account=${params.budget}"

    opts.join(' ')
  }

  // for splice the dbs will be staged so remove the automatic download if the dbs are not found
  withName: 'DOWNLOAD_MGNIFY_GENOMES_REFERENCE_DBS|DOWNLOAD_DRAM_DB|DOWNLOAD_HUMAN_PHIX_BWAMEM2_INDEX' {
      errorStrategy = 'terminate'
      beforeScript = """
      echo "ERROR: A reference-database download was triggered, but downloads are disabled on this HPC profile." >&2
      echo "This means the staged databases were not found at the expected paths:" >&2
      echo "  --reference_dbs:           ${params.reference_dbs}" >&2
      echo "  --decontamination_indexes: ${params.decontamination_indexes}" >&2
      echo "Check that your databases are staged correctly and point --reference_dbs / --decontamination_indexes at them." >&2
      exit 1
      """
    }
}

env {
  // Nextflow executor tuning for EPCC style CPU:MEM rules
  NXF_EXECUTOR_MEM_GIGA_PER_CORE = 2
}

// Provide EPCC defaults without forcing them into the pipeline base config
params {
  // Optional, used only for Slurm submission defaults above
  slurm_partition = params.slurm_partition ?: null
  qos = params.qos ?: null
  budget = params.budget ?: null

  // SPLICE job identifiers if your platform provides them
  job_id       = params.job_id       ?: null
  short_job_id = params.short_job_id ?: null

  // Make outdir deterministic for platform runs, but do not override if user sets it
  outdir = "./${params.job_id ?: 'unknown_job'}_output"

  // SPLICE job JSON inputs
  // Only used if you run in platform mode or demo mode, and can be overridden on CLI
  job_json  = params.job_json  ?: "${launchDir}/../input_data/data/job_file.json"
  input_dir = params.input_dir ?: "${launchDir}/../input_data/data"

  // Publishing behaviour commonly used on EPCC object stores
  publish_dir_mode = params.publish_dir_mode ?: 'copy'

  trace_report_suffix = (params.job_id ? "${params.job_id}_" : "") + new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

  validationLenientMode = true
}

// -------------------------
// Containers on EPCC
// -------------------------
singularity {
  enabled    = true
  autoMounts = true

  // Parameterise to avoid hard coding repo layouts
  cacheDir = "containers"
}

docker.enabled = false
conda.enabled  = false
